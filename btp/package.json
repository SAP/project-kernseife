{
  "name": "kernseife",
  "version": "1.4.2",
  "description": "CAP App for Kernseife",
  "repository": "https://github.tools.sap/Kernseife/kernseifeApp.git",
  "engines": {
    "node": ">=20",
    "npm": ">=11"
  },
  "author": "Daniel Huser",
  "scripts": {
    "start": "cds-serve",
    "dev": "cds-ts watch",
    "update:version": "node ./scripts/updateVersion.js",
    "hybrid": "cds-ts watch --profile hybrid",
    "format": "npx pretty-quick --pattern \"**/*.*(js|ts|json)\" && format-cds",
    "lint": "eslint . --fix",
    "prebuild": "npm run lint && npm run cleanup:build",
    "build": "cds build --production",
    "postbuild": "npm run cleanup:ts",
    "build:bundle": "npm ci --omit=dev --prefix=gen/srv && npm ci --omit=dev --prefix=gen/db",
    "cleanup:build": "npx rimraf resources mta_archives app/resources app/**/dist",
    "cleanup:ts": "npx rimraf gen/**/*.ts",
    "generate-cds-types": "npx @cap-js/cds-typer \"*\" --outputDirectory @cds-models",
    "test": "jest --silent",
    "mbt": "npm run update:version && mbt build -t gen/mtar -m=verbose -j=8",
    "deploy-dev": "cf deploy gen/mtar/kernseife_$npm_package_version.mtar -e=BTP_DEV.mtaext",
    "deploy-production": "cf deploy gen/mtar/kernseife_$npm_package_version.mtar -e=BTP_PROD.mtaext"
  },
  "dependencies": {
    "@cap-js/hana": "2.8.0",
    "@cap-js/cds-typer": "0.40.0",
    "@cap-js/cds-types": "0.18.0",
    "@grpc/grpc-js": "1.14.4",
    "@sap-cloud-sdk/connectivity": "4.7.0",
    "@sap-cloud-sdk/http-client": "4.7.0",
    "@sap-cloud-sdk/resilience": "4.7.0",
    "@sap-cloud-sdk/util": "4.7.0",
    "@sap/cds": "9.9.2",
    "@sap/xssec": "4.13.0",
    "axios": "1.18.1",
    "dayjs": "1.11.21",
    "express": "4.22.2",
    "helmet": "8.2.0",
    "is-ci": "4.1.0",
    "jszip": "3.10.1",
    "papaparse": "5.5.4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "1.0.1",
    "@cap-js/sqlite": "2.4.0",
    "@eslint/js": "9.34.0",
    "@jest/globals": "29.7.0",
    "@sap/eslint-plugin-cds": "4.2.4",
    "@sap/ux-specification": "1.144.6",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.20.0",
    "@types/papaparse": "5.5.2",
    "@types/sap__xsenv": "3.3.2",
    "@ui5/cli": "4.0.57",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "mbt": "1.2.49",
    "prettier": "3.9.4",
    "replace-in-file": "8.4.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1"
  },
  "cds": {
    "requires": {
      "queue": false,
      "[production]": {
        "db": "hana"
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "any": {
              "roles": []
            },
            "viewer": {
              "password": "viewer",
              "roles": [
                "classification-viewer",
                "development-viewer"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "admin",
                "classification-viewer",
                "classification-manager",
                "development-viewer",
                "development-manager",
                "analyst"
              ]
            }
          }
        }
      },
      "kernseife_btp": {
        "kind": "odata-v4",
        "model": "srv/external/kernseife_btp",
        "csrf": true,
        "credentials": {
          "path": "/sap/opu/odata4/sap/zknsf_btp_connector/srvd/sap/zknsf_btp_connector/0001"
        }
      }
    },
    "log": {
      "levels": {
        "db": "error",
        "sql": "error",
        "cds": "info"
      }
    }
  },
  "sapux": [
    "app/analyze-score",
    "app/analyze-overview",
    "app/import-center",
    "app/configure-setting",
    "app/manage-development-object",
    "app/monitor-job",
    "app/manage-release-state",
    "app/manage-classification",
    "app/manage-extension"
  ],
  "workspaces": [
    "app/*",
    "db/*"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}