{
  "name": "kernseife",
  "version": "1.4.2",
  "description": "CAP App for Kernseife",
  "repository": "https://github.tools.sap/Kernseife/kernseifeApp.git",
  "engines": {
    "node": "^22.22.2 || ^24.18.0 || >=26.0.0",
    "npm": ">=11"
  },
  "author": "Daniel Huser",
  "scripts": {
    "start": "cds-serve",
    "dev": "cds-ts watch",
    "update:version": "node ./scripts/updateVersion.js",
    "hybrid": "cds-ts watch --profile hybrid",
    "format": "pretty-quick --pattern \"**/*.*(js|ts|json)\" && format-cds",
    "lint": "eslint . --fix",
    "prebuild": "npm run lint && npm run cleanup:build",
    "build": "cds build --production",
    "postbuild": "npm run cleanup:ts",
    "build:bundle": "npm ci --omit=dev --prefix=gen/srv && npm ci --omit=dev --prefix=gen/db",
    "cleanup:build": "npx rimraf resources mta_archives app/resources app/**/dist",
    "cleanup:ts": "npx rimraf gen/**/*.ts",
    "generate-cds-types": "npx @cap-js/cds-typer \"*\" --outputDirectory @cds-models",
    "pretest": "npm run generate-cds-types",
    "test": "jest --silent",
    "pretest:typecheck": "npm run generate-cds-types",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "mbt": "npm run update:version && mbt build -t gen/mtar -m=verbose -j=8",
    "deploy-dev": "cf deploy gen/mtar/kernseife_$npm_package_version.mtar -e=BTP_DEV.mtaext",
    "deploy-production": "cf deploy gen/mtar/kernseife_$npm_package_version.mtar -e=BTP_PROD.mtaext"
  },
  "dependencies": {
    "@cap-js/hana": "3.1.2",
    "@grpc/grpc-js": "1.14.6",
    "@sap-cloud-sdk/connectivity": "4.9.1",
    "@sap-cloud-sdk/http-client": "4.9.1",
    "@sap-cloud-sdk/resilience": "4.9.1",
    "@sap-cloud-sdk/util": "4.9.1",
    "@sap/cds": "10.2.1",
    "@sap/xssec": "4.15.0",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "is-ci": "4.1.0",
    "jszip": "3.10.2",
    "papaparse": "5.7.0"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "0.41.1",
    "@cap-js/cds-types": "0.20.0",
    "@cap-js/cds-test": "1.0.2",
    "@cap-js/sqlite": "3.1.2",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@sap/eslint-plugin-cds": "4.2.5",
    "@sap/ux-specification": "1.144.13",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/sap__xsenv": "3.3.2",
    "@ui5/cli": "4.0.71",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "mbt": "1.2.49",
    "prettier": "3.9.10",
    "replace-in-file": "9.0.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "@sap/cds-dk": "10.2.0",
    "pretty-quick": "4.2.2"
  },
  "overrides": {
    "@ui5/project": {
      "pacote": "22.0.1"
    },
    "lodash": "4.18.1",
    "pacote": {
      "sigstore": "5.0.0"
    }
  },
  "cds": {
    "requires": {
      "queue": false,
      "[production]": {
        "db": "hana"
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "any": {
              "roles": []
            },
            "viewer": {
              "password": "viewer",
              "roles": [
                "classification-viewer",
                "development-viewer"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "admin",
                "classification-viewer",
                "classification-manager",
                "development-viewer",
                "development-manager",
                "analyst"
              ]
            }
          }
        }
      },
      "kernseife_btp": {
        "kind": "odata-v4",
        "model": "srv/external/kernseife_btp",
        "csrf": true,
        "credentials": {
          "path": "/sap/opu/odata4/sap/zknsf_btp_connector/srvd/sap/zknsf_btp_connector/0001"
        }
      }
    },
    "log": {
      "levels": {
        "db": "error",
        "sql": "error",
        "cds": "info"
      }
    }
  },
  "sapux": [
    "app/analyze-score",
    "app/analyze-overview",
    "app/import-center",
    "app/configure-setting",
    "app/manage-development-object",
    "app/monitor-job",
    "app/manage-release-state",
    "app/manage-classification",
    "app/manage-extension",
    "app/manage-exemption"
  ],
  "workspaces": [
    "app/*"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "allowScripts": {
    "@cap-js/cds-types@": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "mbt@1.2.49": true,
    "tree-sitter": true,
    "tree-sitter-java": true,
    "better-sqlite3": true,
    "protobufjs": true,
    "@parcel/watcher": true,
    "unrs-resolver": true,
    "@sap/hana-client": true
  }
}
