@EndUserText.label: 'Kernseife: BTP Access'
@MappingRole: true
define role ZKNSF_BTP_ACCESS {
  grant select on ZKNSF_I_PROJECTS;
  grant select on ZKNSF_I_DEVELOPMENT_OBJECTS;
  grant select on ZKNSF_I_FINDINGS;
  grant select on ZKNSF_I_METRICS;
  grant select on ZKNSF_I_OBJECT_COUNT;
  grant select on ZKNSF_I_FINDING_COUNT;
  grant select on ZKNSF_I_RUN_STATE;
  grant select on ZKNSF_I_EXEMPTIONS;
}